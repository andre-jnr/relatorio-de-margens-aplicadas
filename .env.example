# Modelo de configuração. Copie para .env e preencha com os dados reais.
# O .env fica fora do Git (veja .gitignore).

# Credenciais padrão do SQL Server (usadas pelas lojas sem usuário/senha próprios)
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_USUARIO=usuario
DB_SENHA=troque-pela-senha

# Lojas exibidas no painel, separadas por vírgula, na ordem desejada.
# Use os apelidos das seções LOJA_<APELIDO>_* abaixo. Vazio = todas as cadastradas.
# O CD nunca aparece (não tem preços de venda).
LOJAS_ATIVAS=parque10,pontanegra,moradadosol,monte,flores

# Cadastro das lojas: LOJA_<APELIDO>_NOME / _SERVIDOR / _BANCO
# e, opcionalmente, _USUARIO / _SENHA quando a loja tem credencial própria.

LOJA_PARQUE10_NOME=Parque Dez
LOJA_PARQUE10_SERVIDOR=nome-ou-ip-do-servidor
LOJA_PARQUE10_BANCO=nome-do-banco

LOJA_PONTANEGRA_NOME=Ponta Negra
LOJA_PONTANEGRA_SERVIDOR=nome-ou-ip-do-servidor
LOJA_PONTANEGRA_BANCO=nome-do-banco

LOJA_MORADADOSOL_NOME=Morada do Sol
LOJA_MORADADOSOL_SERVIDOR=nome-ou-ip-do-servidor
LOJA_MORADADOSOL_BANCO=nome-do-banco

LOJA_MONTE_NOME=Monte das Oliveiras
LOJA_MONTE_SERVIDOR=nome-ou-ip-do-servidor
LOJA_MONTE_BANCO=nome-do-banco

LOJA_FLORES_NOME=Flores
LOJA_FLORES_SERVIDOR=nome-ou-ip-do-servidor
LOJA_FLORES_BANCO=nome-do-banco
LOJA_FLORES_USUARIO=usuario
LOJA_FLORES_SENHA=senha
